#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Lint check - 只检查错误，不检查警告
echo "📋 Running ESLint..."
# --quiet 标记会抑制警告，只显示错误
# --max-warnings=-1 禁用警告计数限制
npx eslint src/ server/src/ --max-warnings=-1 --quiet
ESLINT_RESULT=$?

if [ $ESLINT_RESULT -ne 0 ]; then
  echo "❌ ESLint failed. Please fix the errors before committing."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
