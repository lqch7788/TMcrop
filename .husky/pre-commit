#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Lint check (only src and server/src, excluding db seed files)
echo "📋 Running ESLint..."
npx eslint src/ server/src/ --max-warnings=500
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Please fix the errors before committing."
  exit 1
fi

# Format check (only src and server/src)
echo "🎨 Checking code format..."
npx prettier --check "src/**/*.{ts,tsx}" "server/src/**/*.{ts}"
if [ $? -ne 0 ]; then
  echo "❌ Code format issues found. Run 'npx prettier --write' to fix."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
