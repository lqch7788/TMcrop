#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Lint check only (prettier will be enabled later after formatting batch)
echo "📋 Running ESLint..."
npx eslint src/ server/src/ --max-warnings=3000
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Please fix the errors before committing."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
