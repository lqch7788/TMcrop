          <mxGeometry x="100" y="280" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- AI评分引擎 -->
        <mxCell id="ai_engine" value="AI综合评分引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="200" height="40" as="geometry"/>
        </mxCell>

        <!-- 评分因素 -->
        <mxCell id="factor1" value="技能匹配度&#xa;30%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="factor2" value="地理位置&#xa;20%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="390" y="140" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="factor3" value="当前负荷&#xa;20%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="factor4" value="历史表现&#xa;15%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="195" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="factor5" value="紧急程度&#xa;10%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="390" y="195" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="factor6" value="批次熟悉度&#xa;3%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="480" y="195" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="factor7" value="天气影响&#xa;5%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="390" y="250" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- 置信度 -->
        <mxCell id="confidence" value="置信度评估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="310" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="conf_high" value="高置信度(≥80)&#xa;→ dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="conf_mid" value="中置信度(60-80)&#xa;→ manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="410" y="360" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="conf_low" value="低置信度(&lt;60)&#xa;→ split/delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- 派工决策 -->
        <mxCell id="decision" value="派工决策" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="430" width="200" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="decision_dispatch" value="直接派发&#xa;dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="280" y="490" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="decision_manual" value="人工确认&#xa;manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="490" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="decision_delay" value="延后处理&#xa;delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- 批量派发建议 -->
        <mxCell id="batch_suggest" value="批量派发建议&#xa;(同一区域≥3任务)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- 执行派发 -->
        <mxCell id="execute" value="executeDispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="200" width="150" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="exec_farm" value="农事任务&#xa;→ status='accepted'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="650" y="260" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="exec_temp" value="临时任务&#xa;→ status='in_progress'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="760" y="260" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="exec_inspect" value="巡查问题&#xa;→ 标记已处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="650" y="315" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- 连接线 -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666" edge="1" parent="1" source="pool_start" target="pool_farm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666" edge="1" parent="1" source="pool_start" target="pool_temp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666" edge="1" parent="1" source="pool_start" target="pool_inspect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 数据说明 -->
        <mxCell id="data_note" value="数据源:&#xa;• useTasks - 农事任务(pending)&#xa;• useTempTasks - 临时任务(pending)&#xa;• useProblemDispatch - 巡查问题&#xa;• usePersistentAttendance - 考勤数据&#xa;• useEnvironmentData - 天气/告警" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="180" height="120" as="geometry"/>
        </mxCell>

        <!-- 返回值说明 -->
        <mxCell id="return_note" value="返回值:&#xa;• taskPool - 待派发任务列表&#xa;• workers - 员工综合状态&#xa;• getRecommendations() - 获取推荐&#xa;• executeDispatch() - 执行派发&#xa;• batchSuggestions - 批量建议&#xa;• stats - 统计信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="180" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

