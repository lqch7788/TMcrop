  <diagram name="任务状态流转图" guid="task-status">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title2" value="任务状态流转图 (10种状态)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 草稿 -->
        <mxCell id="status_draft" value="草稿&#xa;draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 待接受 -->
        <mxCell id="status_pending" value="待接受&#xa;pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 已接受 -->
        <mxCell id="status_accepted" value="已接受&#xa;accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 处理中 -->
        <mxCell id="status_in_progress" value="处理中&#xa;in_progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 待验收 -->
        <mxCell id="status_waiting" value="待验收&#xa;waiting_acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 已完成 -->
        <mxCell id="status_completed" value="已完成&#xa;completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 返工中 -->
        <mxCell id="status_rejected" value="返工中&#xa;rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 任务失败 -->
        <mxCell id="status_failed" value="任务失败&#xa;failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="300" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 已取消 -->
        <mxCell id="status_cancelled" value="已取消&#xa;cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccc;strokeColor=#666;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 已放弃 -->
        <mxCell id="status_abandoned" value="已放弃&#xa;abandoned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="500" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- 流转箭头和标签 -->
        <!-- draft -> pending -->
        <mxCell id="flow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;endArrow=classic;endFill=1" edge="1" parent="1" source="status_draft" target="status_pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label1" value="发布 publish" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="210" y="140" width="100" height="20" as="geometry"/>
        </mxCell>

        <!-- draft -> cancelled -->
        <mxCell id="flow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666;endArrow=classic;endFill=1" edge="1" parent="1" source="status_draft" target="status_cancelled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label2" value="删除" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="210" y="80" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- pending -> accepted -->
        <mxCell id="flow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=classic;endFill=1" edge="1" parent="1" source="status_pending" target="status_accepted">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label3" value="接受 accept" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="210" y="240" width="100" height="20" as="geometry"/>
        </mxCell>

        <!-- pending -> cancelled -->
        <mxCell id="flow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666;endArrow=classic;endFill=1" edge="1" parent="1" source="status_pending" target="status_cancelled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label4" value="撤回 withdraw" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="200" y="175" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- accepted -> in_progress -->
        <mxCell id="flow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=classic;endFill=1" edge="1" parent="1" source="status_accepted" target="status_in_progress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label5" value="开始 start" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="210" y="340" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- accepted -> cancelled -->
        <mxCell id="flow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666;endArrow=classic;endFill=1" edge="1" parent="1" source="status_accepted" target="status_cancelled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
