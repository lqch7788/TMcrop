        </mxCell>

        <!-- waiting -> completed -->
        <mxCell id="flow10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;endArrow=classic;endFill=1" edge="1" parent="1" source="status_waiting" target="status_completed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label10" value="验收 complete" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="210" y="540" width="100" height="20" as="geometry"/>
        </mxCell>

        <!-- waiting -> rejected -->
        <mxCell id="flow11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;endArrow=classic;endFill=1" edge="1" parent="1" source="status_waiting" target="status_rejected">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label11" value="驳回 reject" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="210" y="490" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- rejected -> in_progress -->
        <mxCell id="flow12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=classic;endFill=1" edge="1" parent="1" source="status_rejected" target="status_in_progress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label12" value="继续 continue" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="310" y="425" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- rejected -> failed (2次返工) -->
        <mxCell id="flow13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;endArrow=classic;endFill=1" edge="1" parent="1" source="status_rejected" target="status_failed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label13" value="2次返工" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="370" y="365" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- failed -> pending -->
        <mxCell id="flow14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;endArrow=classic;endFill=1" edge="1" parent="1" source="status_failed" target="status_pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label14" value="重新派发 reassign" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="100" height="20" as="geometry"/>
        </mxCell>

        <!-- in_progress -> abandoned -->
        <mxCell id="flow15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;endArrow=classic;endFill=1" edge="1" parent="1" source="status_in_progress" target="status_abandoned">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="label15" value="超时放弃" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="210" y="460" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- 状态说明 -->
        <mxCell id="note1" value="状态说明:&#xa;• draft(草稿): 任务创建后未发布&#xa;• pending(待接受): 已发布，等待执行人接受&#xa;• accepted(已接受): 执行人已接受任务&#xa;• in_progress(处理中): 任务正在执行&#xa;• waiting_acceptance(待验收): 执行人提交，等待验收&#xa;• completed(已完成): 验收通过&#xa;• rejected(返工中): 验收驳回，需返工&#xa;• failed(任务失败): 2次返工后仍不通过&#xa;• cancelled(已取消): 任务被取消&#xa;• abandoned(已放弃): 超时后执行人放弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;fontSize=10;align=left;spacing=5" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="280" height="200" as="geometry"/>
        </mxCell>

        <!-- 操作说明 -->
        <mxCell id="note2" value="核心操作:&#xa;• publish - 发布任务 (draft→pending)&#xa;• withdraw - 撤回任务 (pending→cancelled)&#xa;• cancel - 取消任务 (accepted/in_progress→cancelled)&#xa;• accept - 接受任务 (pending→accepted)&#xa;• start - 开始执行 (accepted→in_progress)&#xa;• progress - 提交进度 (in_progress更新)&#xa;• submit - 申请验收 (in_progress→waiting)&#xa;• complete - 验收通过 (waiting→completed)&#xa;• reject - 验收驳回 (waiting→rejected)&#xa;• continue - 继续执行 (rejected→in_progress)&#xa;• reassign - 重新派发 (failed→pending)&#xa;• extend_deadline - 延期&#xa;• remind - 催办&#xa;• overtime_continue/abandon - 超时处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;fontSize=10;align=left;spacing=5" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="320" height="280" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="任务操作流程图" guid="task-operations">
