        <mxCell id="rel4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="task_entity" target="temptask_entity">
