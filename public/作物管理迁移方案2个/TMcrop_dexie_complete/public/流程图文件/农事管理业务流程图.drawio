  <diagram name="智能派工流程图" guid="smart-dispatch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title4" value="智能派工流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 任务池 -->
        <mxCell id="pool_start" value="任务池" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="pool_farm" value="农事任务&#xa;(pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="80" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="pool_temp" value="临时任务&#xa;(pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="160" y="140" width="80" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="pool_inspect" value="巡查问题&#xa;(待处理)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
