        <!-- in_progress -> rejected -->
        <mxCell id="flow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;endArrow=classic;endFill=1" edge="1" parent="1" source="status_in_progress" target="status_rejected">
