          <mxGeometry x="210" y="440" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- in_progress -> cancelled -->
        <mxCell id="flow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666;endArrow=classic;endFill=1" edge="1" parent="1" source="status_in_progress" target="status_cancelled">
          <mxGeometry relative="1" as="geometry"/>
