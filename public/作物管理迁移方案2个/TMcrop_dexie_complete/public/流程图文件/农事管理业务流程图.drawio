        </mxCell>

        <!-- STORAGE_KEYS -->
        <mxCell id="storage_note" value="localStorage 存储键:&#xa;• TASKS - 任务数据&#xa;• TEMP_TASKS - 临时任务&#xa;• PROBLEMS - 问题记录&#xa;• INSPECTIONS - 巡查记录&#xa;• WORK_LOGS - 工作日志&#xa;• ATTENDANCE - 考勤记录&#xa;• TASK_RECORDS - 操作记录&#xa;• TASK_REMINDERS - 催办记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="200" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>