          <mxGeometry x="200" y="270" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- in_progress -> waiting -->
        <mxCell id="flow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;endArrow=classic;endFill=1" edge="1" parent="1" source="status_in_progress" target="status_waiting">
          <mxGeometry relative="1" as="geometry"/>
