        <mxCell id="flow9_reject" value="第1次: 原执行人继续&#xa;第2次: 退回重新分派" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#D32F2F;fontSize=10;" vertex="1" parent="1">
