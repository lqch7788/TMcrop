        <mxCell id="note3" value="3. 任务编号格式：&#xa;   TKRW + YYYYMMDD + 序号&#xa;   例如：TKRW20260416-001" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5D4037;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="180" height="50" as="geometry" />
