        <mxCell id="note1" value="1. 巡查编号格式：&#xa;   XT + YYYYMMDD + 序号&#xa;   例如：XT20260416-001" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5D4037;" vertex="1" parent="1">
