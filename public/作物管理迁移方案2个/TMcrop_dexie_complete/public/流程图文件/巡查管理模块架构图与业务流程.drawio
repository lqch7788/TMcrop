        <mxCell id="note2" value="2. 问题编号格式：&#xa;   PD + YYYYMMDD + 序号&#xa;   例如：PD20260416-001" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5D4037;" vertex="1" parent="1">
