<mxfile>
  <diagram name="任务状态流转图" updated="2026-04-23">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="任务状态流转图（10种状态）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 第一行状态节点（正常流程） -->
        <!-- draft 草稿 -->
        <mxCell id="s_draft" value="draft&#xa;草稿" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#595959;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- pending 待接受 -->
        <mxCell id="s_pending" value="pending&#xa;待接受" style="ellipse;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#ffe58f;strokeColor=#d46b08;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- accepted 已接受 -->
        <mxCell id="s_accepted" value="accepted&#xa;已接受" style="ellipse;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#b7eb8f;strokeColor=#389e0d;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- in_progress 进行中 -->
        <mxCell id="s_in_progress" value="in_progress&#xa;进行中" style="ellipse;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#91d5ff;strokeColor=#096dd9;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- waiting_acceptance 待验收 -->
        <mxCell id="s_waiting" value="waiting_acceptance&#xa;待验收" style="ellipse;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#ffd591;strokeColor=#d46b08;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="110" height="60" as="geometry"/>
        </mxCell>

        <!-- completed 已完成 -->
        <mxCell id="s_completed" value="completed&#xa;已完成" style="ellipse;whiteSpace=wrap;html=1;fontColor=#ffffff;fillColor=#52c41a;strokeColor=#237804;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="120" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- 第二行状态节点（异常状态） -->
        <!-- abandoned 已放弃 -->
        <mxCell id="s_abandoned" value="abandoned&#xa;已放弃" style="ellipse;whiteSpace=wrap;html=1;fontColor=#000000;fillColor=#bfbfbf;strokeColor=#595959;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- cancelled 已取消 -->
        <mxCell id="s_cancelled" value="cancelled&#xa;已取消" style="ellipse;whiteSpace=wrap;html=1;fontColor=#ffffff;fillColor=#8c8c8c;strokeColor=#434343;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- rejected 返工中 -->
        <mxCell id="s_rejected" value="rejected&#xa;返工中" style="ellipse;whiteSpace=wrap;html=1;fontColor=#ffffff;fillColor=#ff7875;strokeColor=#cf1322;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="280" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- failed 任务失败 -->
        <mxCell id="s_failed" value="failed&#xa;任务失败" style="ellipse;whiteSpace=wrap;html=1;fontColor=#ffffff;fillColor=#ff4d4f;strokeColor=#a8071a;fontSize=14;align=center;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- 流转连线（正常流程 - 第一行从左到右） -->
        <!-- draft -> pending (派发) -->
        <mxCell id="l1" value="派发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52c41a;strokeWidth=3;endArrow=classic;endFill=1" edge="1" parent="1" source="s_draft" target="s_pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- pending -> accepted (接受) -->
        <mxCell id="l2" value="接受" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52c41a;strokeWidth=3;endArrow=classic;endFill=1" edge="1" parent="1" source="s_pending" target="s_accepted">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- accepted -> in_progress (开始执行) -->
        <mxCell id="l3" value="开始执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52c41a;strokeWidth=3;endArrow=classic;endFill=1" edge="1" parent="1" source="s_accepted" target="s_in_progress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- in_progress -> waiting_acceptance (提交验收) -->
        <mxCell id="l4" value="提交验收" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52c41a;strokeWidth=3;endArrow=classic;endFill=1" edge="1" parent="1" source="s_in_progress" target="s_waiting">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- waiting_acceptance -> completed (验收通过) -->
        <mxCell id="l5" value="验收通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52c41a;strokeWidth=3;endArrow=classic;endFill=1" edge="1" parent="1" source="s_waiting" target="s_completed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 异常流程连线 -->
        <!-- waiting_acceptance -> rejected (验收驳回-第1次) -->
        <mxCell id="l6" value="验收驳回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ff4d4f;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_waiting" target="s_rejected">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="855" y="180"/>
              <mxPoint x="855" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- rejected -> in_progress (继续执行) -->
        <mxCell id="l7" value="继续执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fa8c16;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_rejected" target="s_in_progress">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="220"/>
              <mxPoint x="670" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- rejected -> failed (第2次驳回) -->
        <mxCell id="l8" value="第2次驳回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ff4d4f;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_rejected" target="s_failed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- rejected -> pending (重新派发) -->
        <mxCell id="l9" value="重新派发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fa8c16;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_rejected" target="s_pending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="220"/>
              <mxPoint x="310" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- failed -> pending (更换执行人) -->
        <mxCell id="l10" value="更换执行人" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fa8c16;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_failed" target="s_pending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="220"/>
              <mxPoint x="310" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- cancelled 取消流程连线 -->
        <!-- accepted -> cancelled (取消任务) -->
        <mxCell id="l11" value="取消任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c8c8c;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_accepted" target="s_cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="180"/>
              <mxPoint x="490" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- in_progress -> cancelled (取消任务) -->
        <mxCell id="l12" value="取消任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c8c8c;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_in_progress" target="s_cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="180"/>
              <mxPoint x="490" y="180"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- pending -> cancelled (撤回任务) -->
        <mxCell id="l13" value="撤回任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8c8c8c;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_pending" target="s_cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="180"/>
              <mxPoint x="490" y="180"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- pending -> abandoned (超时放弃) -->
        <mxCell id="l14" value="超时放弃" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#bfbfbf;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_pending" target="s_abandoned">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- abandoned -> pending (重新接受) -->
        <mxCell id="l15" value="重新接受" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#bfbfbf;strokeWidth=2;endArrow=classic;endFill=1;dashed=1" edge="1" parent="1" source="s_abandoned" target="s_pending">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend_box" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontColor=#000000;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="60" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="leg1" value="正常流程" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#000000;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="160" y="400" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg_line1" value="" style="endArrow=classic;html=1;strokeColor=#52c41a;strokeWidth=3" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="410" as="sourcePoint"/>
            <mxPoint x="240" y="410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="leg2" value="异常/驳回" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#000000;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="160" y="430" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg_line2" value="" style="endArrow=classic;html=1;strokeColor=#ff4d4f;strokeWidth=3;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="440" as="sourcePoint"/>
            <mxPoint x="240" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="leg3" value="取消/放弃" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#000000;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="160" y="460" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg_line3" value="" style="endArrow=classic;html=1;strokeColor=#8c8c8c;strokeWidth=2;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="470" as="sourcePoint"/>
            <mxPoint x="240" y="470" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 说明文字 -->
        <mxCell id="note" value="说明：&#xa;1. 任务有10种状态，正常流程：草稿-待接受-已接受-进行中-待验收-已完成&#xa;2. 验收驳回后进入返工中状态，可继续执行或重新派发&#xa;3. 第2次驳回后任务失败，需更换执行人重新派发&#xa;4. 已接受/进行中的任务可被取消&#xa;5. 待接受状态超过时限会被标记为已放弃" style="text;html=1;strokeColor=#666;fillColor=#fffbe6;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="500" height="120" as="geometry"/>
        </mxCell>

        <!-- 状态颜色说明 -->
        <mxCell id="color_title" value="状态颜色说明：" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontColor=#000000;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="650" y="400" width="110" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="color_desc" value="灰色：草稿/已放弃&#xa;黄色：待接受/待验收&#xa;绿色：已接受/已完成&#xa;蓝色：进行中&#xa;橙色：返工中&#xa;红色：任务失败&#xa;灰色：已取消" style="text;html=1;strokeColor=#999;fillColor=#fffbe6;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="650" y="425" width="180" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>