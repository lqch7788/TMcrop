        <mxCell id="legend4" value="&#9632; 完成阶段" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap=wrap;fontSize=11;fontColor=#27AE60;" vertex="1" parent="1">
          <mxGeometry x="860" y="235" width="130" height="20" as="geometry" />
