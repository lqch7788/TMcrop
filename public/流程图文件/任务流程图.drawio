        <mxCell id="legend5" value="&#9632; 追踪阶段" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap=wrap;fontSize=11;fontColor=#3498DB;" vertex="1" parent="1">
