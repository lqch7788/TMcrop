        <mxCell id="legend3" value="&#9632; 审核阶段" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap=wrap;fontSize=11;fontColor=#9B59B6;" vertex="1" parent="1">
          <mxGeometry x="860" y="210" width="130" height="20" as="geometry" />
