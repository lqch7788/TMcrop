<mxfile host="app.diagrams.net" modified="2026-04-08T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="农事任务流程" id="farming-task-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始节点 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00FF00;strokeColor=#00AA00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="30" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- 任务创建 -->
        <mxCell id="task_create" value="任务创建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90E2;strokeColor=#2E5984;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 任务安排 -->
        <mxCell id="task_arrange" value="任务安排&#xa;(分配人员/设备/时间)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90E2;strokeColor=#2E5984;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="220" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 任务执行 -->
        <mxCell id="task_execute" value="任务执行&#xa;(农户/工人执行)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;strokeColor=#C57E0D;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="320" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 提交完成 -->
        <mxCell id="task_submit" value="提交完成&#xa;(上传照片/数据)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;strokeColor=#C57E0D;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 审核节点 -->
        <mxCell id="task_review" value="完成情况审核" style="rhombus;whiteSpace=wrap;html=1;fillColor=#9B59B6;strokeColor=#7D3C98;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="530" y="510" width="100" height="80" as="geometry" />
        </mxCell>

        <!-- 审核通过 -->
        <mxCell id="review_pass" value="审核通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="530" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- 审核不通过 -->
        <mxCell id="review_fail" value="审核不通过&#xa;(打回重做)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#B03A2E;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- 任务完成 -->
        <mxCell id="task_complete" value="任务完成&#xa;(归档)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="620" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- 任务追踪 -->
        <mxCell id="task_trace" value="任务追踪&#xa;(生成报告/分析)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3498DB;strokeColor=#2874A6;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="620" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 结束节点 -->
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF0000;strokeColor=#AA0000;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="720" width="80" height="50" as="geometry" />
        </mxCell>

        <!-- 打回重做后重新执行 -->
        <mxCell id="redo" value="重新执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#B03A2E;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- 连接线 -->
        <!-- 开始 -> 任务创建 -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="start" target="task_create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 任务创建 -> 任务安排 -->
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="task_create" target="task_arrange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 任务安排 -> 任务执行 -->
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="task_arrange" target="task_execute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 任务执行 -> 提交完成 -->
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="task_execute" target="task_submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 提交完成 -> 审核 -->
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="task_submit" target="task_review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 审核 -> 通过 -->
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#27AE60;" edge="1" parent="1" source="task_review" target="review_pass">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 审核 -> 不通过 -->
        <mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E74C3C;" edge="1" parent="1" source="task_review" target="review_fail">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 通过 -> 任务完成 -->
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#27AE60;" edge="1" parent="1" source="review_pass" target="task_complete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 任务完成 -> 任务追踪 -->
        <mxCell id="edge9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="task_complete" target="task_trace">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 任务追踪 -> 结束 -->
        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="task_trace" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 不通过 -> 重新执行 -->
        <mxCell id="edge11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E74C3C;dashed=1;" edge="1" parent="1" source="review_fail" target="redo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 重新执行 -> 任务执行 -->
        <mxCell id="edge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#E74C3C;dashed=1;" edge="1" parent="1" source="redo" target="task_execute">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 标签：否 -->
        <mxCell id="label1" value="否" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap=wrap;fontSize=12;fontColor=#E74C3C;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="40" height="20" as="geometry" />
