        <mxCell id="legend2" value="&#9632; 执行阶段" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap=wrap;fontSize=11;fontColor=#F5A623;" vertex="1" parent="1">
