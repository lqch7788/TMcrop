        <mxCell id="p14d-ap1" value="&lt;b&gt;二级审批&lt;/b&gt;&lt;br&gt;财务审核" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;spacing=2;" vertex="1" parent="cost-base-root">
