  <diagram name="批量审批通用流程" id="batch-flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="batch-flow-root" parent="0" />
        <mxCell id="p15-t" value="批量审批通用流程（支持22种审批类型）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b-s" value="开始" style="fontColor=#000000;ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="60" y="60" width="70" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b-s1" value="&lt;b&gt;1. 选择审批单&lt;/b&gt;&lt;br&gt;• 列表页勾选复选框&lt;br&gt;• 支持全选/取消全选&lt;br&gt;• 仅显示有权限且支持批量的项" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="20" y="110" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="b-a1" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-s" target="b-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-s2" value="&lt;b&gt;2. 权限校验&lt;/b&gt;&lt;br&gt;• 校验每张单据的审批权限&lt;br&gt;• 过滤无权限/已处理单据&lt;br&gt;• 灰色显示不可选项" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="20" y="230" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="b-a2" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-s1" target="b-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-s3" value="&lt;b&gt;3. 确认弹窗&lt;/b&gt;&lt;br&gt;• 展示审批单明细列表&lt;br&gt;• 显示审批意见输入框&lt;br&gt;• 二次确认（防误操作）" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#d6b656;fontSize=11;align=left;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="280" y="230" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="b-a3" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-s2" target="b-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-s4" value="&lt;b&gt;4. 逐条执行审批&lt;/b&gt;&lt;br&gt;• for each 选中的审批单&lt;br&gt;• 独立执行业务联动&lt;br&gt;• 一个失败不影响其他" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#d6b656;fontSize=11;align=left;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="540" y="230" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="b-a4" value="确认" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-s3" target="b-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-s5" value="&lt;b&gt;5. 结果反馈&lt;/b&gt;&lt;br&gt;• 成功列表（绿色）&lt;br&gt;• 失败列表（红色+原因）&lt;br&gt;• 支持对失败项重试" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#d6b656;fontSize=11;align=left;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="800" y="230" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="b-a5" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-s4" target="b-s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-d" value="有失败项？&lt;br&gt;用户选择重试？" style="fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="840" y="370" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-a6" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-s5" target="b-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e1" value="结束" style="fontColor=#000000;ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="880" y="510" width="70" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b-a7" value="否/完成" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="batch-flow-root" source="b-d" target="b-e1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-a8" value="是" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="batch-flow-root" source="b-d" target="b-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-note1" value="&lt;b&gt;关键设计点：&lt;/b&gt;&lt;br&gt;• 每个审批单独立执行，互不影响&lt;br&gt;• 权限校验前置，无权限项不可选&lt;br&gt;• 二次确认防误操作&lt;br&gt;• 结果明细展示，支持失败重试" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="20" y="370" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-note2" value="&lt;b&gt;支持批量审批的类型（22项）：&lt;/b&gt;&lt;br&gt;领料单、采购申请、生产计划、采收申请&lt;br&gt;退料单、种源入库、物料入库、库存调拨&lt;br&gt;订单创建、订单变更、任务派发、任务变更&lt;br&gt;巡查问题、问题整改、育苗计划、种植计划&lt;br&gt;生产批次、批次变更、批次作废、技术方案&lt;br&gt;预算编制、预算调整、请假、加班、考勤补录&lt;br&gt;&lt;br&gt;&lt;b&gt;不支持批量（10项人事/薪资敏感）：&lt;/b&gt;&lt;br&gt;离职、招聘、入职、调薪、合同续签、工资预算、转岗" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="20" y="490" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="b-note3" value="&lt;b&gt;批量部分通过：&lt;/b&gt;&lt;br&gt;目前仅&quot;领料单&quot;支持批量部分通过&lt;br&gt;（涉及物料数量审批），其他类型暂不支持" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="batch-flow-root">
          <mxGeometry x="20" y="730" width="300" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
