        <mxCell id="p14d-aa2" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="cost-base-root" source="p14d-ap1" target="p14d-ap2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p14d-ok" value="&lt;b&gt;审批通过&lt;/b&gt;&lt;br&gt;• 设备状态：已报废&lt;br&gt;• 扣减资产账&lt;br&gt;• 生成处置记录&lt;br&gt;• 通知相关人员" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacing=2;" vertex="1" parent="cost-base-root">
          <mxGeometry x="800" y="1850" width="160" height="102" as="geometry" />
        </mxCell>
        <mxCell id="p14d-aok" value="" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="cost-base-root" source="p14d-ap2" target="p14d-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p14d-no" value="&lt;b&gt;审批拒绝&lt;/b&gt;&lt;br&gt;• 报废被拒绝&lt;br&gt;• 设备保持有效&lt;br&gt;• 可重新申请" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacing=2;" vertex="1" parent="cost-base-root">
          <mxGeometry x="800" y="2100" width="160" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p14d-ar0" value="驳回" style="fontColor=#000000;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="cost-base-root" source="p14d-ap0" target="p14d-no">
