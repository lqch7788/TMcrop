          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p14d-ap2" value="&lt;b&gt;三级审批&lt;/b&gt;&lt;br&gt;总经理" style="fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;spacing=2;" vertex="1" parent="cost-base-root">
