        <mxCell id="p14d-info" value="审批类型：DEVICE_SCRAP | 支持批量：否 | 业务联动：资产扣减 + 处置记录 + 通知" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="cost-base-root">
