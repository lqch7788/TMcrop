        </mxCell>
        <mxCell id="b-note1" value="&lt;b&gt;关键设计点：&lt;/b&gt;&lt;br&gt;• 每个审批单独立执行，互不影响&lt;br&gt;• 权限校验前置，无权限项不可选&lt;br&gt;• 二次确认防误操作&lt;br&gt;• 结果明细展示，支持失败重试" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="60" y="80" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-note2" value="&lt;b&gt;支持批量审批的类型（22项）：&lt;/b&gt;&lt;br&gt;领料单、采购申请、生产计划、采收申请&lt;br&gt;退料单、种源入库、物料入库、库存调拨&lt;br&gt;订单创建、订单变更、任务派发、任务变更&lt;br&gt;巡查问题、问题整改、育苗计划、种植计划&lt;br&gt;生产批次、批次变更、批次作废、技术方案&lt;br&gt;预算编制、预算调整、请假、加班、考勤补录&lt;br&gt;&lt;br&gt;&lt;b&gt;不支持批量（10项人事/薪资敏感）：&lt;/b&gt;&lt;br&gt;离职、招聘、入职、调薪、合同续签、工资预算、转岗" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="60" y="220" width="360" height="220" as="geometry" />
        </mxCell>
        <mxCell id="b-note3" value="&lt;b&gt;批量部分通过：&lt;/b&gt;&lt;br&gt;目前仅&amp;quot;领料单&amp;quot;支持批量部分通过&lt;br&gt;（涉及物料数量审批），其他类型暂不支持" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="60" y="480" width="300" height="70" as="geometry" />
        </mxCell>
      </root>
