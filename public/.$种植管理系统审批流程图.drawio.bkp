  <diagram name="批量审批通用流程" id="batch-approval">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="b0" />
        <mxCell id="b1" parent="b0" />
        <mxCell id="b-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;批量审批通用流程（支持22种审批类型）&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="b1">
          <mxGeometry x="380" y="20" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="b1">
          <mxGeometry x="560" y="80" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-step1" value="&lt;b&gt;1. 选择审批单&lt;/b&gt;&lt;br&gt;• 列表页勾选复选框&lt;br&gt;• 支持全选/取消全选&lt;br&gt;• 仅显示有权限且支持批量的项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="500" y="160" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-start" target="b-step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-step2" value="&lt;b&gt;2. 权限校验&lt;/b&gt;&lt;br&gt;• 校验每张单据的审批权限&lt;br&gt;• 过滤无权限/已处理单据&lt;br&gt;• 灰色显示不可选项" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="500" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-step1" target="b-step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-step2-no" value="无可审批项&lt;br&gt;提示用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="260" y="320" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow2-no" value="无" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-step2" target="b-step2-no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-step3" value="&lt;b&gt;3. 确认弹窗&lt;/b&gt;&lt;br&gt;• 展示审批单明细列表&lt;br&gt;• 显示审批意见输入框&lt;br&gt;• 二次确认（防误操作）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="500" y="460" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow3" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-step2" target="b-step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-step3-cancel" value="取消操作&lt;br&gt;返回列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="260" y="480" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow3-cancel" value="取消" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-step3" target="b-step3-cancel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-step4" value="&lt;b&gt;4. 逐条执行审批&lt;/b&gt;&lt;br&gt;• for each 选中的审批单&lt;br&gt;• 独立执行业务联动&lt;br&gt;• 一个失败不影响其他" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="800" y="460" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow4" value="确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-step3" target="b-step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-step5" value="&lt;b&gt;5. 结果反馈&lt;/b&gt;&lt;br&gt;• 成功列表（绿色）&lt;br&gt;• 失败列表（红色+原因）&lt;br&gt;• 支持对失败项重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#0070c0;fontSize=11;align=left;spacing=2;" vertex="1" parent="b1">
          <mxGeometry x="1100" y="460" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b1" source="b-step4" target="b-step5">
