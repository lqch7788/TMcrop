        <!-- 数据字段说明 -->
        <mxCell id="fields_title" value="任务创建涉及字段：" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontColor=#000000;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="140" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="fields" value="id - 任务ID&#xa;taskCode - 任务编号&#xa;title - 任务标题&#xa;type - 任务类型&#xa;greenhouseName - 执行区域&#xa;priority - 优先级&#xa;status - 任务状态&#xa;assigneeId - 执行人ID&#xa;assigneeName - 执行人姓名&#xa;createdAt - 创建时间&#xa;dueDate - 截止日期&#xa;estimatedHours - 预计工时" style="text;html=1;strokeColor=#999;fillColor=#f0f5ff;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
