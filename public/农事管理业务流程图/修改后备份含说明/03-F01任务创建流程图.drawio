<mxfile>
  <diagram name="F01任务创建流程图" updated="2026-04-23">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="F01 任务创建流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- 开始节点 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#52c41a;strokeColor=#237804;fontSize=14;fontColor=#ffffff;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- 流程节点 -->
        <mxCell id="p1" value="点击&#xa;【新建任务】按钮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1890ff;strokeColor=#096dd9;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="550" y="160" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p2" value="打开&#xa;CreateTaskModal弹窗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1890ff;strokeColor=#096dd9;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="550" y="240" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p3" value="填写任务信息&#xa;标题/类型/区域/日期/工时/优先级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1890ff;strokeColor=#096dd9;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="550" y="320" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p4" value="数据校验&#xa;title非空/greenhouse非空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1890ff;strokeColor=#096dd9;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="550" y="400" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- 判断节点 -->
        <mxCell id="d1" value="是否选择&#xa;执行人？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fa8c16;strokeColor=#d46b08;fontSize=12;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="570" y="480" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- 是的分支 - 有执行人 -->
        <mxCell id="p5_yes" value="创建任务&#xa;状态=pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#52c41a;strokeColor=#237804;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="800" y="490" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p6_yes" value="记录操作日志&#xa;创建TaskRecord" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#722ed1;strokeColor=#531d93;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="800" y="570" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p7_yes" value="发送通知&#xa;提醒执行人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1890ff;strokeColor=#096dd9;fontSize=14;fontColor=#ffffff;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="800" y="650" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 否的分支 - 无执行人 -->
        <mxCell id="p5_no" value="创建任务&#xa;状态=draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#595959;fontSize=14;fontColor=#595959;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p6_no" value="保存到草稿&#xa;待后续派发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#595959;fontSize=14;fontColor=#595959;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="340" y="570" width="160" height="50" as="geometry"/>
