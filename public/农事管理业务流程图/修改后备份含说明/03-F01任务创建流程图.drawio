        <mxCell id="comp" value="CreateTaskModal&#xa;TaskTab&#xa;useTasks" style="text;html=1;strokeColor=#999;fillColor=#f0f5ff;fontColor=#000000;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
