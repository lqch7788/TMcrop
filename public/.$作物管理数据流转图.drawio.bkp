<mxfile host="app.diagrams.net" modified="2026-04-26T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="作物管理数据流转图" id="crop-management-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 标题 -->
        <mxCell id="title" value="作物管理模块数据流转图" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="400" height="40" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="20" fontStyle="1" align="center" bold="1"/>
          </mxStyle>
        </mxCell>

        <!-- 订单管理（可选起点）-->
        <mxCell id="order" value="订单管理&#xa;CropOrder" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="200" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#E3F2FD" strokeColor="#1976D2" rounded="1"/>
          </mxStyle>
        </mxCell>

        <!-- 虚线箭头：从订单到种源 -->
        <mxCell id="arrow1" edge="1" parent="1" source="order" target="seedSource">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="500" y="160" as="sourcePoint"/>
            <mxPoint x="500" y="200" as="targetPoint"/>
          </mxGeometry>
          <mxStyle as="style">
            <mxCellStyle dashed="1" strokeColor="#666666" fontColor="#666666" fontSize="10"/>
          </mxStyle>
        </mxCell>
        <mxCell id="label1" value="（可选）关联" vertex="1" connectable="0" parent="1">
          <mxGeometry x="520" y="160" width="80" height="20" as="geometry"/>
        </mxCell>

        <!-- 种源管理 -->
        <mxCell id="seedSource" value="种源管理&#xa;SeedSource" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="180" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#E8F5E9" strokeColor="#388E3C" rounded="1"/>
          </mxStyle>
        </mxCell>

        <!-- 虚线箭头：从种源到作物实例 -->
        <mxCell id="arrow2" edge="1" parent="1" source="seedSource" target="cropInstance">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="350" y="230" as="sourcePoint"/>
            <mxPoint x="400" y="230" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="label2" value="创建实例" vertex="1" connectable="0" parent="1">
          <mxGeometry x="360" y="200" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- 作物实例（核心） -->
        <mxCell id="cropInstance" value="CropInstance&#xa;作物实例（核心）" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="180" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#FFF3E0" strokeColor="#F57C00" rounded="1" bold="1"/>
          </mxStyle>
        </mxCell>

        <!-- 消耗可用数量标签 -->
        <mxCell id="label3" value="消耗&#xa;availableCount" vertex="1" connectable="0" parent="1">
          <mxGeometry x="100" y="280" width="80" height="30" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="9" align="center" fontColor="#666666"/>
          </mxStyle>
        </mxCell>

        <!-- 箭头：种源到育苗 -->
        <mxCell id="arrow3" edge="1" parent="1" source="seedSource" target="seedling">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="260" as="sourcePoint"/>
            <mxPoint x="280" y="320" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="190" y="260"/>
              <mxPoint x="280" y="260"/>
              <mxPoint x="280" y="320"/>
            </Array>
          </mxGeometry>
          <mxStyle as="style">
            <mxCellStyle strokeColor="#388E3C" fontColor="#388E3C"/>
          </mxStyle>
        </mxCell>

        <!-- 育苗管理 -->
        <mxCell id="seedling" value="育苗管理&#xa;Seedling" vertex="1" parent="1">
          <mxGeometry x="190" y="320" width="180" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#E3F2FD" strokeColor="#1976D2" rounded="1"/>
          </mxStyle>
        </mxCell>

        <!-- 标签：扣减种源数量 -->
        <mxCell id="label4" value="扣减&#xa;availableCount" vertex="1" connectable="0" parent="1">
          <mxGeometry x="70" y="280" width="80" height="30" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="9" align="center" fontColor="#666666"/>
          </mxStyle>
        </mxCell>

        <!-- 箭头：育苗到种植 -->
        <mxCell id="arrow4" edge="1" parent="1" source="seedling" target="planting">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="380" as="sourcePoint"/>
            <mxPoint x="370" y="440" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="370" y="380"/>
              <mxPoint x="490" y="380"/>
              <mxPoint x="490" y="440"/>
            </Array>
          </mxGeometry>
          <mxStyle as="style">
            <mxCellStyle strokeColor="#1976D2" fontColor="#1976D2"/>
          </mxStyle>
        </mxCell>

        <!-- 标签：定植操作 -->
        <mxCell id="label5" value="定植操作" vertex="1" connectable="0" parent="1">
          <mxGeometry x="390" y="390" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- 种植管理 -->
        <mxCell id="planting" value="种植管理&#xa;Planting" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="180" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#E8F5E9" strokeColor="#388E3C" rounded="1"/>
          </mxStyle>
        </mxCell>

        <!-- 箭头：种植到采收 -->
        <mxCell id="arrow5" edge="1" parent="1" source="planting" target="harvest">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="500" as="sourcePoint"/>
            <mxPoint x="580" y="560" as="targetPoint"/>
          </mxGeometry>
          <mxStyle as="style">
            <mxCellStyle strokeColor="#388E3C" fontColor="#388E3C"/>
          </mxStyle>
        </mxCell>

        <!-- 标签：采收 -->
        <mxCell id="label6" value="采收" vertex="1" connectable="0" parent="1">
          <mxGeometry x="600" y="510" width="50" height="20" as="geometry"/>
        </mxCell>

        <!-- 采收入库 -->
        <mxCell id="harvest" value="采收入库&#xa;HarvestRecord" vertex="1" parent="1">
          <mxGeometry x="500" y="560" width="180" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#FCE4EC" strokeColor="#C2185B" rounded="1"/>
          </mxStyle>
        </mxCell>

        <!-- 箭头：采收到订单 -->
        <mxCell id="arrow6" edge="1" parent="1" source="harvest" target="orderSale">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="620" as="sourcePoint"/>
            <mxPoint x="800" y="620" as="targetPoint"/>
          </mxGeometry>
          <mxStyle as="style">
            <mxCellStyle strokeColor="#C2185B" fontColor="#C2185B"/>
          </mxStyle>
        </mxCell>

        <!-- 标签：销售 -->
        <mxCell id="label7" value="销售出库" vertex="1" connectable="0" parent="1">
          <mxGeometry x="710" y="600" width="60" height="20" as="geometry"/>
        </mxCell>

        <!-- 销售订单（终点） -->
        <mxCell id="orderSale" value="订单管理&#xa;（销售）" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="160" height="60" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" align="center" verticalAlign="middle" fillColor="#E1F5FE" strokeColor="#0277BD" rounded="1"/>
          </mxStyle>
        </mxCell>

        <!-- 更新作物实例数量标签 -->
        <mxCell id="label8" value="更新&#xa;harvestedQuantity&#xa;currentQuantity" vertex="1" connectable="0" parent="1">
          <mxGeometry x="620" y="470" width="100" height="40" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="9" align="center" fontColor="#F57C00"/>
          </mxStyle>
        </mxCell>

        <!-- ==================== 编码生成规则框 ==================== -->
        <mxCell id="codeRuleTitle" value="编码生成规则" vertex="1" parent="1">
          <mxGeometry x="850" y="80" width="300" height="30" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="14" fontStyle="1" align="center" fillColor="#FAFAFA" strokeColor="#BDBDBD"/>
          </mxStyle>
        </mxCell>

        <mxCell id="codeRuleBox" value="种源批号：ZZ + 日期 + 流水号&#xa;例：ZZ20260426-001&#xa;&#xa;育苗批号：YM + 年月日 + 流水号&#xa;例：YM20260426-001&#xa;&#xa;种植批号：来源批号 + 日期&#xa;例：YM20260426-001-20260301&#xa;&#xa;采收单号：HS + 年月日 + 流水号&#xa;例：HS20260426001&#xa;&#xa;订单编号：DD + 年月日 + 流水号&#xa;例：DD20260426001&#xa;&#xa;作物编码：9位（PD + 类型 + 品种 + 序号）&#xa;例：PD03010001&#xa;&#xa;实例编码：作物编码(9位) + 年月日(6位) + 流水号(3位) = 18位&#xa;例：PD0301000100240426001&#xa;&#xa;溯源码：TR + 日期 + 作物名前2字&#xa;例：TR20260426番茄" vertex="1" parent="1">
          <mxGeometry x="850" y="110" width="320" height="300" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#FAFAFA" strokeColor="#BDBDBD"/>
          </mxStyle>
        </mxCell>

        <!-- ==================== 数量变化规则框 ==================== -->
        <mxCell id="qtyRuleTitle" value="数量变化规则" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="120" height="25" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" fontStyle="1" align="center" fillColor="#FFF8E1" strokeColor="#F9A825"/>
          </mxStyle>
        </mxCell>

        <mxCell id="qtyRuleBox" value="种源入库：&#xa;  initialCount = quantity × 1000&#xa;  availableCount = initialCount&#xa;&#xa;育苗创建：&#xa;  availableCount -= 育苗数量&#xa;&#xa;定植操作：&#xa;  plantedQuantity += 定植数量&#xa;&#xa;采收入库：&#xa;  harvestedQuantity += 采收数量&#xa;  currentQuantity -= 采收数量&#xa;  currentQuantity ≤ 0 → status='harvested'" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="130" height="180" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="9" align="left" verticalAlign="top" fillColor="#FFFDE7" strokeColor="#F9A825"/>
          </mxStyle>
        </mxCell>

        <!-- ==================== 溯源链结构 ==================== -->
        <mxCell id="traceTitle" value="溯源链结构 CropTraceChain" vertex="1" parent="1">
          <mxGeometry x="850" y="440" width="300" height="30" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" fontStyle="1" align="center" fillColor="#E8F5E9" strokeColor="#388E3C"/>
          </mxStyle>
        </mxCell>

        <mxCell id="traceBox" value="CropTraceChain {&#xa;  instance: CropInstance,    // 作物实例&#xa;  order?: CropOrder,        // 关联订单&#xa;  seedSource?: SeedSource,   // 种源记录&#xa;  seedlings?: Seedling[],   // 育苗记录列表&#xa;  plantings?: Planting[],     // 种植记录列表&#xa;  harvests?: HarvestRecord[] // 采收记录列表&#xa;}" vertex="1" parent="1">
          <mxGeometry x="850" y="470" width="320" height="150" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#E8F5E9" strokeColor="#388E3C" fontFamily="Courier New"/>
          </mxStyle>
        </mxCell>

        <!-- ==================== 数据存储 ==================== -->
        <mxCell id="storageTitle" value="localStorage 存储" vertex="1" parent="1">
          <mxGeometry x="50" y="640" width="300" height="30" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="12" fontStyle="1" align="center" fillColor="#ECEFF1" strokeColor="#607D8B"/>
          </mxStyle>
        </mxCell>

        <mxCell id="storageBox" value="localStorage = {&#xa;  'crop_instances': [...],       // 作物实例&#xa;  'crop_orders': [...],         // 订单&#xa;  'crop_seed_sources': [...],   // 种源&#xa;  'crop_seedlings': [...],      // 育苗&#xa;  'crop_plantings': [...],      // 种植&#xa;  'harvest_records': [...]      // 采收记录&#xa;}" vertex="1" parent="1">
          <mxGeometry x="50" y="670" width="300" height="120" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#ECEFF1" strokeColor="#607D8B" fontFamily="Courier New"/>
          </mxStyle>
        </mxCell>

        <!-- ==================== 流程步骤说明 ==================== -->
        <mxCell id="stepTitle" value="操作流程示例" vertex="1" parent="1">
          <mxGeometry x="50" y="800" width="600" height="30" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="14" fontStyle="1" align="center" fillColor="#E3F2FD" strokeColor="#1976D2"/>
          </mxStyle>
        </mxCell>

        <mxCell id="stepBox" value="完整生命周期流程：&#xa;&#xa;① 种源入库 → 在【种源管理】新增种源，系统自动创建 CropInstance&#xa;&#xa;② 育苗创建 → 在【育苗管理】新增育苗，扣减种源 availableCount，更新实例状态&#xa;&#xa;③ 定植操作 → 在【育苗管理】点击【定植】，跳转到【种植管理】创建种植记录&#xa;               更新 CropInstance.plantedQuantity&#xa;&#xa;④ 采收入库 → 在【采收入库】新增采收记录，更新实例 harvestedQuantity&#xa;               当 currentQuantity ≤ 0 时，状态更新为 'harvested'&#xa;&#xa;⑤ 销售出库 → 在【订单管理】关联实例，完成订单，状态更新为 'outbound'" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="600" height="180" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="11" align="left" verticalAlign="top" fillColor="#E3F2FD" strokeColor="#1976D2"/>
          </mxStyle>
        </mxCell>

        <!-- ==================== 图例 ==================== -->
        <mxCell id="legendTitle" value="图例" vertex="1" parent="1">
          <mxGeometry x="700" y="800" width="100" height="25" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="11" fontStyle="1" align="center"/>
          </mxStyle>
        </mxCell>

        <mxCell id="legend1" value="━━ 实线：正常数据流" vertex="1" parent="1">
          <mxGeometry x="700" y="830" width="150" height="20" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left"/>
          </mxStyle>
        </mxCell>

        <mxCell id="legend2" value="-- - 虚线：可选/关联关系" vertex="1" parent="1">
          <mxGeometry x="700" y="855" width="150" height="20" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" dashed="1"/>
          </mxStyle>
        </mxCell>

        <mxCell id="legend3" value="━━ 彩色线：数量更新" vertex="1" parent="1">
          <mxGeometry x="700" y="880" width="150" height="20" as="geometry"/>
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" strokeColor="#F57C00"/>
          </mxStyle>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
