          </mxStyle>
        </mxCell>

        <mxCell id="codeRuleBox" parent="1" value="┌───────────────────────────────────────────┐&#xa;│ 【作物编码】9位                        │&#xa;│ 格式：类别(2) + 类型(2) + 品种(2) + 流水号(3)   │&#xa;│ 示例：PD0301001                         │&#xa;│   PD = 蔬菜类                           │&#xa;│   03 = 茄果类                          │&#xa;│   01 = 番茄                            │&#xa;│   001 = 第1个编码                       │&#xa;├───────────────────────────────────────────┤&#xa;│ 【种源批号】                             │&#xa;│ 格式：ZZ + 年月日(8位) + &quot;-&quot; + 流水号(3位)  │&#xa;│ 示例：ZZ20260426-001                    │&#xa;├───────────────────────────────────────────┤&#xa;│ 【实例编码】18位                         │&#xa;│ 格式：作物编码(9) + 年月日(6) + 流水号(3)  │&#xa;│ 示例：PD030100101240426001              │&#xa;├───────────────────────────────────────────┤&#xa;│ 【溯源码】                               │&#xa;│ 格式：TR + 年月日 + 作物名前2字          │&#xa;│ 示例：TR20260426番茄                     │&#xa;└───────────────────────────────────────────┘" vertex="1">
          <mxGeometry height="280" width="320" x="1100" y="1200" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#E3F2FD" strokeColor="#1565C0" fontFamily="Courier New" />
          </mxStyle>
        </mxCell>

        <!-- ============================================ -->
        <!-- 底部：数据流总结 -->
        <!-- ============================================ -->

        <mxCell id="flowSummaryTitle" parent="1" value="完整生命周期数据流" vertex="1">
          <mxGeometry height="40" width="600" x="80" y="1100" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="14" fontStyle="1" align="center" fillColor="#FFF3E0" strokeColor="#E65100" bold="1" />
          </mxStyle>
        </mxCell>

        <mxCell id="flowSummary" parent="1" value="┌─────────┐    ┌─────────┐    ┌─────────┐    ┌─────────┐    ┌─────────┐    ┌─────────┐&#xa;│品种库   │───▶│种源入库 │───▶│育苗管理 │───▶│定植操作 │───▶│采收入库 │───▶│销售出库 │&#xa;│(选作物) │    │(创建实例)│    │(扣库存) │    │(更新实例)│    │(更新数量)│    │(完成订单)│&#xa;└─────────┘    └────┬────┘    └────┬────┘    └────┬────┘    └────┬────┘    └────┬────┘&#xa;                       │              │              │              │              │&#xa;                       ▼              ▼              ▼              ▼              ▼&#xa;                   ┌─────────────────────────────────────────────────────────┐&#xa;                   │              CropInstance (作物实例 - 核心实体)               │&#xa;                   │                                                         │&#xa;                   │  • 创建：种源入库时自动创建实例                       │&#xa;                   │  • 更新：育苗/定植/采收时更新数量和状态                 │&#xa;                   │  • 追溯：通过实例编码可追溯完整生命周期                 │&#xa;                   └─────────────────────────────────────────────────────────┘" vertex="1">
          <mxGeometry height="220" width="700" x="80" y="1150" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#FFF8E1" strokeColor="#E65100" fontFamily="Courier New" />
          </mxStyle>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
