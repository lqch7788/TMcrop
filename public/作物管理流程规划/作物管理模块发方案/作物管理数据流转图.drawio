        <mxCell id="codeRuleTitle" parent="1" value="编码生成规则" vertex="1">
          <mxGeometry height="30" width="300" x="850" y="80" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="14" fontStyle="1" align="center" fillColor="#FAFAFA" strokeColor="#BDBDBD" />
          </mxStyle>
        </mxCell>
        <mxCell id="codeRuleBox" parent="1" value="种源批号：ZZ + 日期 + 流水号&#xa;例：ZZ20260426-001&#xa;&#xa;育苗批号：YM + 年月日 + 流水号&#xa;例：YM20260426-001&#xa;&#xa;种植批号：来源批号 + 日期&#xa;例：YM20260426-001-20260301&#xa;&#xa;采收单号：HS + 年月日 + 流水号&#xa;例：HS20260426001&#xa;&#xa;订单编号：DD + 年月日 + 流水号&#xa;例：DD20260426001&#xa;&#xa;作物编码：9位（PD + 类型 + 品种 + 序号）&#xa;例：PD03010001&#xa;&#xa;实例编码：作物编码(9位) + 年月日(6位) + 流水号(3位) = 18位&#xa;例：PD0301000100240426001&#xa;&#xa;溯源码：TR + 日期 + 作物名前2字&#xa;例：TR20260426番茄" vertex="1">
          <mxGeometry height="300" width="320" x="850" y="110" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#FAFAFA" strokeColor="#BDBDBD" />
          </mxStyle>
        </mxCell>
        <mxCell id="qtyRuleTitle" parent="1" value="数量变化规则" vertex="1">
          <mxGeometry height="25" width="120" x="60" y="385" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="12" fontStyle="1" align="center" fillColor="#FFF8E1" strokeColor="#F9A825" />
          </mxStyle>
        </mxCell>
        <mxCell id="qtyRuleBox" parent="1" value="种源入库：&#xa;  initialCount = quantity × 1000&#xa;  availableCount = initialCount&#xa;&#xa;育苗创建：&#xa;  availableCount -= 育苗数量&#xa;&#xa;定植操作：&#xa;  plantedQuantity += 定植数量&#xa;&#xa;采收入库：&#xa;  harvestedQuantity += 采收数量&#xa;  currentQuantity -= 采收数量&#xa;  currentQuantity ≤ 0 → status=&#39;harvested&#39;" vertex="1">
          <mxGeometry height="220" width="230" x="50" y="410" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="9" align="left" verticalAlign="top" fillColor="#FFFDE7" strokeColor="#F9A825" />
          </mxStyle>
        </mxCell>
        <mxCell id="traceTitle" parent="1" value="溯源链结构 CropTraceChain" vertex="1">
          <mxGeometry height="30" width="300" x="850" y="440" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="12" fontStyle="1" align="center" fillColor="#E8F5E9" strokeColor="#388E3C" />
          </mxStyle>
        </mxCell>
        <mxCell id="traceBox" parent="1" value="CropTraceChain {&#xa;  instance: CropInstance,    // 作物实例&#xa;  order?: CropOrder,        // 关联订单&#xa;  seedSource?: SeedSource,   // 种源记录&#xa;  seedlings?: Seedling[],   // 育苗记录列表&#xa;  plantings?: Planting[],     // 种植记录列表&#xa;  harvests?: HarvestRecord[] // 采收记录列表&#xa;}" vertex="1">
          <mxGeometry height="150" width="320" x="850" y="470" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#E8F5E9" strokeColor="#388E3C" fontFamily="Courier New" />
          </mxStyle>
        </mxCell>
        <mxCell id="storageTitle" parent="1" value="localStorage 存储" vertex="1">
          <mxGeometry height="30" width="300" x="50" y="640" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="12" fontStyle="1" align="center" fillColor="#ECEFF1" strokeColor="#607D8B" />
          </mxStyle>
        </mxCell>
        <mxCell id="storageBox" parent="1" value="localStorage = {&#xa;  &#39;crop_instances&#39;: [...],       // 作物实例&#xa;  &#39;crop_orders&#39;: [...],         // 订单&#xa;  &#39;crop_seed_sources&#39;: [...],   // 种源&#xa;  &#39;crop_seedlings&#39;: [...],      // 育苗&#xa;  &#39;crop_plantings&#39;: [...],      // 种植&#xa;  &#39;harvest_records&#39;: [...]      // 采收记录&#xa;}" vertex="1">
          <mxGeometry height="120" width="300" x="50" y="670" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="10" align="left" verticalAlign="top" fillColor="#ECEFF1" strokeColor="#607D8B" fontFamily="Courier New" />
          </mxStyle>
        </mxCell>
        <mxCell id="stepTitle" parent="1" value="操作流程示例" vertex="1">
          <mxGeometry height="30" width="600" x="50" y="800" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="14" fontStyle="1" align="center" fillColor="#E3F2FD" strokeColor="#1976D2" />
          </mxStyle>
        </mxCell>
        <mxCell id="stepBox" parent="1" value="完整生命周期流程：&#xa;&#xa;① 种源入库 → 在【种源管理】新增种源，系统自动创建 CropInstance&#xa;&#xa;② 育苗创建 → 在【育苗管理】新增育苗，扣减种源 availableCount，更新实例状态&#xa;&#xa;③ 定植操作 → 在【育苗管理】点击【定植】，跳转到【种植管理】创建种植记录&#xa;               更新 CropInstance.plantedQuantity&#xa;&#xa;④ 采收入库 → 在【采收入库】新增采收记录，更新实例 harvestedQuantity&#xa;               当 currentQuantity ≤ 0 时，状态更新为 &#39;harvested&#39;&#xa;&#xa;⑤ 销售出库 → 在【订单管理】关联实例，完成订单，状态更新为 &#39;outbound&#39;" vertex="1">
          <mxGeometry height="180" width="600" x="50" y="830" as="geometry" />
          <mxStyle as="style">
            <mxCellStyle fontSize="11" align="left" verticalAlign="top" fillColor="#E3F2FD" strokeColor="#1976D2" />
          </mxStyle>
        </mxCell>
