# ============================================
# 弘智耘种植管理系统 — Server 环境变量模板
# 2026-08-24 PR-C：AI 模型部署配置
# ============================================
#
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 取消注释并填写真实值（仅替换 = 后的内容）
#   3. 重启 server 让新配置生效
#
# .env 已在 .gitignore 中（不会被提交）

# ============ 基础配置 ============

# 演示模式 — 开发环境必须开启（否则 JWT 鉴权会阻止登录）
DEMO_MODE=true

# JWT 密钥（DEMO_MODE=true 时自动生成随机密钥）
# JWT_SECRET=your-secret-key-here

# JWT 过期时间
# JWT_EXPIRES_IN=24h

# ============ AI 模型部署状态 ============
#
# AIPanel 顶部"AI 模型部署状态"横幅会显示 6 个端口的部署情况：
#   ✅ 已部署 → 模块立即可用
#   ❌ 未部署 → 点击查看部署指南

# ----- AI-06 工时预测 MLP 模型（PR2 已部署） -----
# 模型位置：server/models/workhour_weights.json + workhour_meta.json
# 训练脚本：server/tools/ml/train_workhour_mlp.py
# 状态：✅ 已部署（n=965, MAPE=12.93%）

# ----- AI-09 病虫害图像识别（PR-C 待训练） -----
# 模型位置：server/models/pest_image.onnx
# 训练脚本：server/tools/ml/train_pest_image_cnn.py（待 PR-C 实施）
# 数据生成：server/tools/ml/generate_synthetic_images.py（PIL 合成图 5500 张）
# 状态：❌ 未部署 → 部署后 AI-09 自动启用真实推理

# ----- AI-11 语音录入 ASR（待集成） -----
# 模型位置：server/models/whisper.onnx
# 集成方案：
#   方案 A（推荐）：使用 OpenAI Whisper API（无需本地模型）
#     AI_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
#     AI_WHISPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#   方案 B：本地 Whisper ONNX（部署复杂，参考 docs/deploy-ai-models.md）
# 状态：❌ 未部署 → 部署后 AI-11 音频路径自动启用

# ----- AI-12 问答助手 LLM 端口（待配置） -----
# 支持任意 OpenAI 兼容 API（OpenAI / DeepSeek / 通义千问 / 本地 Ollama 等）
#
# 示例 1：OpenAI 官方
# AI_LLM_API_URL=https://api.openai.com/v1/chat/completions
# AI_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_LLM_MODEL=gpt-3.5-turbo
#
# 示例 2：DeepSeek
# AI_LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# AI_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_LLM_MODEL=deepseek-chat
#
# 示例 3：本地 Ollama（无需 API Key）
# AI_LLM_API_URL=http://localhost:11434/v1/chat/completions
# AI_LLM_API_KEY=ollama
# AI_LLM_MODEL=qwen2.5
#
# AI_LLM_TIMEOUT_MS=30000        # 超时毫秒（默认 30000）
#
# 状态：✅ 已配置 DeepSeek（2026-09-02 实测通过）
# 关闭时 AI-12 返回"知识库中未找到..."（已有真实检索逻辑，不伪装 LLM 回答）

# ----- AI-11 语音录入 ASR（Whisper，可选） -----
# 方案 A（推荐）：OpenAI Whisper API（无需本地模型）
# AI_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# AI_WHISPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 方案 B：兼容 OpenAI 格式的自托管 ASR（如 faster-whisper-server）
# AI_WHISPER_API_URL=http://localhost:8000/v1/audio/transcriptions
# AI_WHISPER_API_KEY=not-needed
#
# 兼容 Azure OpenAI（部署 whisper 模型后）：
# AI_WHISPER_API_URL=https://{resource}.openai.azure.com/openai/deployments/{deploy-name}/audio/transcriptions?api-version=2024-06-01
# AI_WHISPER_API_KEY=your-azure-key
# AI_WHISPER_MODEL={deploy-name}        # Azure 部署名（默认 whisper-1）
# AI_WHISPER_AUTH_HEADER=api-key        # Azure 不用 Bearer，改用 api-key header
# AI_WHISPER_AUTH_PREFIX=               # api-key 模式下前缀留空
#
# 自托管非默认模型名（如 faster-whisper 加载自定义模型）：
# AI_WHISPER_MODEL=Systran/faster-whisper-large-v3
#
# 状态：❌ 未配置 → AI-11 仅文本路径可用（音频路径 Fail Loud 提示配置）

# ----- AI-14 异常检测（规则引擎，无需模型） -----
# 状态：✅ 已部署（Z-score + IQR 统计规则）

# ----- AI-15 出勤异常（滑动窗口规则，无需模型） -----
# 状态：✅ 已部署（连续缺勤/迟到/请假阈值检测）

# ============ 数据库配置（可选） ============

# SQLite 数据库路径（默认：server/data/yuanxingtu.db）
# DB_PATH=./data/yuanxingtu.db

# ============ 服务器配置（可选） ============

# 服务端口（默认：3001）
# PORT=3001

# CORS 允许的源（默认：*）
# CORS_ORIGIN=*

# 日志级别（默认：info）
# LOG_LEVEL=info

# ============ 其他服务集成（可选） ============

# IoT 传感器平台接入
# IOT_PLATFORM_URL=
# IOT_PLATFORM_KEY=

# 短信通知平台
# SMS_API_URL=
# SMS_API_KEY=

# 钉钉/企业微信机器人
# WEBHOOK_URL=

# ============ 天气（环境监测卡片用） ============
#
# 2026-08-28：Open-Meteo（天气数据，免 Key）+ 百度地图逆地理（地址，国内快）
#
# BAIDU_MAP_AK — 百度地图服务端 AK。申请：https://lbsyun.baidu.com/apiconsole/key
# 应用类型选"服务端"。个人开发者免费 6000 次/天。
# 不配也能用：位置会显示经纬度（如 "39.90°N, 116.41°E"）。
BAIDU_MAP_AK=your_baidu_ak
#
# 备选：和风天气（已废弃，2026-08-28 切到 Open-Meteo）
# QWEATHER_API_KEY=your_key_here
# QWEATHER_API_HOST=api.qweather.com
# QWEATHER_GEO_HOST=geoapi.qweather.com
#
# 状态：✅ 已默认启用
